#!/bin/bash
# Build serial + MPI on a Vanda CPU compute node (the login node is a VM, and
# -march=native must target the compute-node CPU, Xeon Platinum 8452Y).
# Submit from the project directory:  qsub scripts/pbs/vanda_build.pbs
# Uses a whole exclusive node: since 11/10 small shared jobs (e.g. 8 cores) fail to
# start on Vanda (Exit_status -3, held after ~20 retries) while whole-node jobs run.
#PBS -N build
#PBS -P personal-CHANGEME
#PBS -l select=1:ncpus=72:mpiprocs=72
#PBS -l place=scatter:excl
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -k oed
#PBS -r n

cd "$PBS_O_WORKDIR"
module load foss/2023b >/dev/null 2>&1
source scripts/pbs/env_info.sh
make clean && make -j16 serial mpi
